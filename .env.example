# Copie de ce fichier : .env (jamais commité). En production, ces valeurs se mettent dans Railway › Variables.
PORT=4173
DATA_DIR=./data
NODE_ENV=development

# PostgreSQL. Sans DATABASE_URL, Nova+ utilise un PostgreSQL embarqué (PGlite) dans DATA_DIR/pglite.
# DATABASE_URL=postgresql://user:password@host:5432/nova

# Chiffre les secrets de double authentification. Chaîne aléatoire de 32 caractères minimum.
NOVA_SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire

# Premier administrateur, créé seulement si la base n'a encore aucun compte. À retirer après la 1re connexion.
NOVA_ADMIN_EMAIL=admin@exemple.fr
NOVA_ADMIN_NAME=Administrateur
NOVA_ADMIN_PASSWORD=mot-de-passe-provisoire-12-caracteres

# Raison sociale pré-remplie au premier démarrage (modifiable dans Administration › Entreprise)
NOVA_COMPANY_NAME=

# Entrée automatique des leads (module commercial). Laisser vide tant que le branchement n'est pas fait.
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0
# NOVA_GOOGLE_LEADS_KEY=
# NOVA_WEBSITE_LEADS_KEY=
